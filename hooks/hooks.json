{
  "description": "AI Collab: publish start/stop status and session activity (subagents and compaction included), surface new peer messages as untrusted context, deliver waiting messages at Stop, and wake an idle session when a peer message arrives (asyncRewake).",
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/ai-collab-hook.mjs\" --host claude", "timeout": 20 }, { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/ai-collab-hook.mjs\" --rewake --host claude", "asyncRewake": true, "timeout": 3600, "rewakeMessage": "ai-collab delivered peer messages while this session was idle.", "rewakeSummary": "ai-collab: new peer message" }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/ai-collab-hook.mjs\" --host claude", "timeout": 10 }, { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/ai-collab-hook.mjs\" --rewake --host claude", "asyncRewake": true, "timeout": 3600, "rewakeMessage": "ai-collab delivered peer messages while this session was idle.", "rewakeSummary": "ai-collab: new peer message" }] }],
    "PreToolUse": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/ai-collab-hook.mjs\" --activity --host claude", "async": true }] },
      { "matcher": "AskUserQuestion", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/ai-collab-hook.mjs\" --host claude", "timeout": 600 }] },
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/ai-collab-hook.mjs\" --read-gate --host claude", "timeout": 10 }] }
    ],
    "PostToolUse": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/ai-collab-hook.mjs\" --host claude", "timeout": 10 }] }],
    "PostToolUseFailure": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/ai-collab-hook.mjs\" --activity --host claude", "async": true }] }],
    "MessageDisplay": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/ai-collab-hook.mjs\" --activity --host claude", "async": true }] }],
    "Notification": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/ai-collab-hook.mjs\" --activity --host claude", "async": true }] }],
    "SubagentStart": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/ai-collab-hook.mjs\" --activity --host claude", "async": true }] }],
    "SubagentStop": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/ai-collab-hook.mjs\" --activity --host claude", "async": true }] }],
    "PreCompact": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/ai-collab-hook.mjs\" --activity --host claude", "async": true }] }],
    "PostModelSwitch": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/ai-collab-hook.mjs\" --activity --host claude", "async": true }] }],
    "PostCompact": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/ai-collab-hook.mjs\" --activity --host claude", "async": true }] }],
    "PermissionRequest": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/ai-collab-hook.mjs\" --host claude", "timeout": 600 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/ai-collab-hook.mjs\" --host claude", "timeout": 660 }, { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/ai-collab-hook.mjs\" --rewake --host claude", "asyncRewake": true, "timeout": 3600, "rewakeMessage": "ai-collab delivered peer messages while this session was idle.", "rewakeSummary": "ai-collab: new peer message" }] }],
    "StopFailure": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/ai-collab-hook.mjs\" --activity --host claude", "async": true }] }],
    "InstructionsLoaded": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/ai-collab-hook.mjs\" --host claude", "async": true, "timeout": 10 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/ai-collab-hook.mjs\" --activity --host claude", "timeout": 3 }] }]
  }
}
