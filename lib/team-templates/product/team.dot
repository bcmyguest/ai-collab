// product: the PM checks the vision, engineering does the work, review reports back to the PM.
// The CEO is not on every task. Every few finished tasks the PM hands over notes.
digraph "product" {
  graph [description="PM checks the vision, engineering builds, review reports to the PM. The CEO sees every few tasks."];
  pm [agent="cursor:grok-4.7-high", prompt="Check this task against the product vision in MISSION.md. Hand it to engineering when it fits. When review reports back, close the task or send it for another pass. Every few finished tasks, not every task, hand the PM notes and the engineer's notes to the CEO. Each tick, clean the backlog: remove done tasks and blocked ids ending in -wt and a number, then render the board. Leave open, ready, building, and review. Do not implement.", fallback="cursor:deepseek-v41-flash-1017-high"];
  engineer [agent="cursor:grok-4.7-high", prompt="Do the engineering work for the task the PM handed you. Record what you learned about engineering direction for the PM. Hand the change to review. Do not set product direction.", fallback="cursor:deepseek-v41-flash-1017-high"];
  review [agent="cursor:grok-4.7-high", prompt="Review the change against the task, including whether a test proves the behavior. Report that result back to the PM. Do not invent the next feature.", fallback="cursor:deepseek-v41-flash-1017-high"];
  ceo [agent="cursor:grok-4.7-high", prompt="You do not see every task. When the PM hands you several finished tasks, read the PM's notes and the engineer's notes, do market research, and keep the company on the vision in MISSION.md. Write the direction. Do not implement.", fallback="cursor:deepseek-v41-flash-1017-high"];
  pm -> engineer [on="in vision", kind="pair", required=true];
  engineer -> review [on="built", kind="pair", required=true];
  review -> engineer [on="changes", kind="pair", required=false, cap=3];
  review -> pm [on="reported", kind="pair", required=true];
  pm -> ceo [on="several tasks", kind="pair", required=false];
  ceo -> done [on="course set", kind="pair", required=false];
  pm -> done [on="task closed", kind="pair", required=true];
}
