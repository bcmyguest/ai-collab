{
  "name": "ai-collab",
  "version": "0.11.0",
  "description": "Best-effort messaging and status between coding-agent peers over a private ntfy server.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "ai-collab": "scripts/ai-collab.mjs"
  },
  "files": [
    ".claude-plugin",
    ".codex-plugin",
    ".cursor-plugin",
    ".mcp.json",
    "commands",
    "deploy",
    "tools/smoke-ui.mjs",
    "tools/screen-state.mjs",
    "hooks",
    "lib",
    "runner",
    "scripts/*.mjs",
    "scripts/ai-collab",
    "scripts/ai-collab-hook",
    "skills",
    "web/app",
    "web/components",
    "web/lib",
    "web/public",
    "web/server",
    "web/*.js",
    "web/*.mjs",
    "web/*.json"
  ],
  "scripts": {
    "lint": "oxlint .",
    "typecheck": "tsc -p tsconfig.core.json",
    "build:package": "node tools/build-package.mjs",
    "test": "node --test",
    "build": "node deploy/build-ui.mjs",
    "runner": "node runner/main.mjs",
    "ui": "next start web -H 127.0.0.1 -p ${AI_COLLAB_UI_PORT:-8795}",
    "demo": "AI_COLLAB_NEXT_DIST=.next-demo next build web && AI_COLLAB_NEXT_DIST=.next-demo node scripts/demo/record.mjs"
  },
  "dependencies": {
    "@a2ui/react": "^0.15.0",
    "@a2ui/web_core": "^0.15.0",
    "@ag-ui/client": "^1.0.5",
    "@ag-ui/core": "^1.0.5",
    "@anthropic-ai/claude-agent-sdk": "^0.3.330",
    "@assistant-ui/react": "^0.15.38",
    "@assistant-ui/react-markdown": "^0.14.26",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@pierre/diffs": "^1.6.4",
    "@tailwindcss/postcss": "^4.3.5",
    "@ui-sdk/core": "0.1.0-beta.16",
    "@ui-sdk/react": "0.1.0-beta.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.77.0",
    "marked": "^18.2.1",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.6.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "web-push": "^4.0.0",
    "zod-v3": "npm:zod@^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/oxlint-config": "^0.2.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fast-check": "^4.11.0",
    "gifenc": "^1.0.3",
    "oxlint": "^1.95.0",
    "playwright-core": "1.65.1",
    "sharp": "^0.35.5",
    "tsrs": "^7.1.0-beta.tsrs5",
    "typescript": "6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bcmyguest/ai-collab.git"
  }
}
